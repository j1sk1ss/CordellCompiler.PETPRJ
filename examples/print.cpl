function _strlen(ptr i8 s) -> i32 {
    i32 l = 0;
    while dref s; {
        s += 1;
        l += 1;
    }

    return l;
}

function _putc(i8 c) -> i0 {
#ifdef CCPL_MACHO64
    syscall(0x2000004, 1, ref c, 1);
#endif
#ifdef CCPL_GNU64
    syscall(1, 1, ref c, 1);
#endif
#ifdef CCPL_GNUI386
    syscall(1, 1, ref c, 1);
#endif
}

function _putn(i32 a, i32 r) -> i0 {
    arr buffer[32, i8];
    i32 pos = 0;
    while a > 0; {
        buffer[pos] = ((a % r) + '0') as i8;
        a /= r;
        pos += 1;
    }
    pos -= 1;
    while pos >= 0; {
        _putc(buffer[pos]);
        pos -= 1;
    }
}

function _puts(ptr i8 s) -> i0 {
    while dref s; {
        _putc(dref s);
        s += 1;
    }
}

function printf(ptr i8 fmt, ...) -> i0 {
    i32 index = 0;
    while index < _strlen(fmt); {
        @[straight]
        @[no_fall]
        switch fmt[index]; {
            case '%'; {
                i8 mode = fmt[index + 1];
                @[straight] switch mode; {
                    case 's'; {
                        @[poparg] ptr i8 s;
                        _puts(s);
                        break;
                    }
                    case 'u'; {}
                    case 'i'; {}
                    case 'l'; {}
                    case 'd'; {
                        @[poparg] i32 n;
                        _putn(n, 10 as i32);
                        break;
                    }
                }

                index += 1;
            }
            default _putc(fmt[index]);
        }

        index += 1;
    }
}

@[entry("main")]
start() {
    printf(ref "Hello! %s, %i %i %i\n", ref "Oregon!", 10 as i32, 11 as i32, 12 as i32);
    exit 0;
}